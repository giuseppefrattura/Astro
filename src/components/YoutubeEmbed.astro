---
interface Props { videoId: string; title: string }
const { videoId, title } = Astro.props;
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}`;
---
<div class="video-embed" data-embed-url={embedUrl} data-title={title}>
  <img src={`https://i3.ytimg.com/vi/${videoId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
  <button type="button" class="video-play" aria-label={`Riproduci video: ${title}`}><span aria-hidden="true">▶ Riproduci video</span></button>
</div>
<a class="video-link" href={`https://www.youtube.com/watch?v=${videoId}`}>Apri il video su YouTube</a>
