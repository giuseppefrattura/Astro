---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BlogListing from '../../components/BlogListing.astro';
import { getPosts, postsPerPage } from '../../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
  const pages = paginate(await getPosts(), { pageSize: postsPerPage });
  return pages.filter(({ props }) => props.page.currentPage > 1);
}) satisfies GetStaticPaths;
interface Props { page: Page<CollectionEntry<'posts'>> }
const { page } = Astro.props;
---
<BlogListing posts={page.data} currentPage={page.currentPage} totalPages={page.lastPage} />
