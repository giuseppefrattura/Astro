---
import { Image } from "astro:assets";
import portrait from "../../public/assets/blog/GiuseppeFrattura.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Links";
const description = "I profili social e i contatti di Giuseppe Frattura.";
const permalink = `${Astro.site.href}links`;
---

<BaseLayout
  title={title}
  description={description}
  permalink={permalink}
  current="about"
>
  <div class="container">
    <!-- 1. Profile Picture  -->
    <Image
      class="profile-picture"
      src={portrait}
      layout="none"
      widths={[100, 200]}
      sizes="100px"
      width="100"
      height="100"
      alt="Ritratto di Giuseppe Frattura"
    />

    <!-- 2. Profile Name or User Account  -->

    <h1 class="profile-name">Giuseppe Frattura</h1>

    <!-- 3. Links  -->
    <a href="https://giuseppefrattura.com" class="links"> Website </a>

    <a href="https://www.instagram.com/giuseppefrattura/" class="links">
      Instagram
    </a>

    <a
      href="https://www.youtube.com/channel/UC8pnHbjxkGgl9b9awlyPtWA"
      class="links"
    >
      YouTube
    </a>

    <a href="https://www.linkedin.com/in/giuseppefrattura/" class="links">
      Linkedin
    </a>

    <a href="https://twitter.com/PeppeFrattura" class="links"> Twitter </a>

    <a href="https://www.tiktok.com/@giuseppefrattura4" class="links">
      TikTok
    </a>

    <a href="https://www.subito.it/utente/3474657" class="links">
      In vendita su Subito.It
    </a>

    <a href="https://www.vinted.it/member/308278915" class="links">
      In vendita su Vinted
    </a>
  </div>
</BaseLayout>

<style>
  .profile-picture {
    display: block;
    margin-left: auto;
    margin-right: auto;

    margin-top: 10%;
    height: auto;
    max-width: 100px;

    border-radius: 50%;
  }

  .profile-name {
    text-align: center;

    padding: 30px;
    font-size: 28px;
  }

  .links {
    text-align: center;
    margin-top: 20px;
    border: 1px solid red;
    border-width: 2px;
    padding: 20px;
    font-weight: bold;

    width: min(290px, 100%);
    display: block;
    margin-left: auto;
    margin-right: auto;

    border-radius: 40px;

    font-size: 18px;
  }

  a {
    text-decoration: none;

    color: var(--text-main);
    transition: color 1s;
  }

  a:hover {
    color: var(--background-body);
    background-color: var(--text-main);
  }
</style>
